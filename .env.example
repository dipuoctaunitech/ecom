# Copy to .env and replace all placeholder values before running locally or deploying.

DATABASE_URL="postgresql://ecommerce:CHANGE_ME_DB_PASSWORD@127.0.0.1:5433/ecommerce?schema=public"

NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL"

MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_ACCESS_KEY="CHANGE_ME_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="CHANGE_ME_MINIO_SECRET_KEY"
MINIO_BUCKET_NAME="ecommerce-assets"

# Used by docker-compose and prisma seed (min 12 chars, mixed case + number)
POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"
MINIO_ROOT_USER="CHANGE_ME_MINIO_ACCESS_KEY"
MINIO_ROOT_PASSWORD="CHANGE_ME_MINIO_SECRET_KEY"
SEED_PASSWORD="ChangeMe1!SeedPass"
